<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_margin="5sp"
        app:cardCornerRadius="20sp"
        app:cardElevation="5sp"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_margin="10sp"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/creditorView"
                android:text="@string/app_name"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/purple_500"
                android:layout_width="wrap_content"
                android:layout_margin="5sp"
                android:layout_height="wrap_content"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/purposeNameView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@+id/amountView"
                    android:text="iugiygiy gykygygygy jkjjjkjjkjkjhj hjhhkjh kkjhkh uhuhuh uhuhuh uhuhuh uhuhu uohuohuoh uohoh oihhoh hoihoh oihh oihuohouhouhoh ohohohohohoh ohohohh oihohohoh"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/amountView"
                    android:text="100"
                    android:layout_margin="10sp"
                    android:textStyle="bold"
                    android:textSize="19sp"
                    android:textColor="@color/purple_500"
                    android:layout_width="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    android:layout_height="wrap_content"/>
            </RelativeLayout>
            <TextView
                android:id="@+id/dateView"
                android:text="@string/app_name"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#8E8E8E"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>